# Copy to .env.local for local development, and set the same variables in your hosting
# provider's dashboard for production. Never commit real values.

# Public: the confirmed production origin, e.g. https://www.example.com
# Until this is set, pages are served with noindex and robots.txt disallows crawling.
NEXT_PUBLIC_SITE_URL=

# Server-only: enquiry email delivery through Resend (https://resend.com)
RESEND_API_KEY=
# Verified sender on a domain you control, e.g. "HempWealth Ghana <enquiries@your-domain>"
ENQUIRY_FROM_EMAIL=
# Inbox(es) that receive enquiries; comma-separate several addresses
ENQUIRY_TO_EMAIL=
